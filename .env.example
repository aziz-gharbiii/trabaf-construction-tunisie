# TRABAF CONSTRUCTION — variables d'environnement
# Copier ce fichier en .env.local pour le développement local.

NEXT_PUBLIC_SITE_URL=https://trabafconstruction.com

# Supabase > Project Settings > API
# La clé "anon" est publique par conception (la sécurité passe par les règles RLS de supabase/setup.sql).
# Ne JAMAIS mettre la clé "service_role" ici ni dans le code.
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
